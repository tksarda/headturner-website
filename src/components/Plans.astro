---
import plans from '../data/plans.json';
import TalkButton from './TalkButton.astro';
---

<section class="section plans-section" id="pricing">
  <header class="section-header">
    <span class="pill">PRICING</span>
    <h2 class="display-m">Pick the level of support you need.</h2>
  </header>
  <div class="plans">
    {plans.map((plan) => (
      <article class="plan">
        <div class="plan__header">
          <span class={`plan-tag plan-tag--${plan.tagStyle}`}><span><img src={plan.icon} width="20" height="20" alt="" /></span>{plan.tag}</span>
          <div class="plan__intro">
            <h3 class="heading-s">{plan.title}</h3>
            <p>{plan.intro}</p>
          </div>
          <TalkButton variant="light" label="Let’s talk" />
        </div>
        <div class="plan__list">
          <ul class="checklist">
            {plan.items.map((item) => <li><img src="/assets/check.svg" width="20" height="20" alt="" />{item}</li>)}
          </ul>
          {plan.note && <p class="t-muted">{plan.note}</p>}
        </div>
      </article>
    ))}
  </div>
</section>
