---
import { url } from '../lib/url';
// Upcoming event. Edit src/data/event.json: the date tile and the "date, place" line fill themselves in,
// and the block hides itself the day after the event (see the event script in src/scripts/main.js).
import event from '../data/event.json';

const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const [, month, day] = event.date.split('-').map(Number);
const monthName = months[month - 1];
const when = `${day} ${monthName}, ${event.place}`;
const external = /^https?:/.test(event.buttonUrl);
---

<section class="section event-section" aria-label="Upcoming event" data-event data-event-date={event.date} data-event-place={event.place}>
  <article class="event">
    <div class="event__image event__date" aria-hidden="true">
      <span class="event__day" data-event-day>{day}</span>
      <span class="event__month" data-event-month>{monthName}</span>
      <span class="event__place"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span data-event-place-text>{event.place}</span></span>
    </div>
    <div class="event__content">
      <span class="pill pill--outline">UPCOMING EVENTS</span>
      <div class="event__text">
        <h2 class="heading-s">{event.title}</h2>
        <p class="t-muted">{event.description} <span data-event-when>{when}</span>.</p>
      </div>
      <a class="btn btn--ink" href={event.buttonUrl} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{event.buttonLabel} <img src={url('/assets/arrow-white.svg')} width="18" height="18" alt="" />{external && <span class="visually-hidden"> (opens in a new tab)</span>}</a>
    </div>
  </article>
</section>
