---
import { url } from '../lib/url';
// Shown only when show.testimonials is true in src/data/site.json (the current quotes are placeholders).
import site from '../data/site.json';
import testimonials from '../data/testimonials.json';
---

{site.show.testimonials && (
  <section class="inset">
    <div class="inset__panel testimonials">
      <h2 class="display-m">{testimonials.heading}</h2>
      <div class="quotes">
        {testimonials.items.map((t) => (
          <figure class="quote">
            <blockquote class="body-l">“{t.quote}”</blockquote>
            <figcaption class="person">
              <span class="person__img"><img src={url(t.photo)} alt="" /></span>
              <span><b>{t.name}</b><span>{t.role}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
