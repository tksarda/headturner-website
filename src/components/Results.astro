---
import { url } from '../lib/url';
// Results, ads carousel and pipeline report. Each part shows only when it is switched on in src/data/sections.json,
// and the whole section disappears when all three are hidden (they hold placeholder content for now).
import { isShown } from '../lib/sections';
import results from '../data/results.json';
import ads from '../data/ads.json';

const showCards = isShown('resultsCards');
const showAds = isShown('ads');
const showPipeline = isShown('pipeline');
---

{(showCards || showAds || showPipeline) && (
  <section class="section results">
    {showCards && (
      <div class="results__top">
        <header class="section-header section-header--wide">
          <span class="pill">RESULTS</span>
          <h2 class="display-m">{results.heading}</h2>
        </header>
        <div class="tilt-grid">
          {results.cards.map((c) => (
            <article class="tilt-card tilt-card--sky" style={`--r:${c.tilt}`}>
              <p class="display-m">{c.figure}</p>
              <p class="t-muted">{c.text}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {showAds && (
      <div class="ads">
        <div class="ads__text">
          <h2 class="display-m">{results.adsHeading}</h2>
          <p class="body-l t-muted">{results.adsIntro}</p>
        </div>
        <div class="carousel" data-carousel>
          <div class="gallery" data-carousel-track tabindex="0" role="region" aria-label="Ads gallery">
            {ads.items.map((ad, i) => (
              <div class="image-slot gallery__item" role="group" aria-label={`Ad ${i + 1} of ${ads.items.length}`}>
                <img src={url(ad.image)} width="576" height="720" alt={ad.alt} loading="lazy" />
              </div>
            ))}
          </div>
          <div class="carousel__controls">
            <button class="carousel__btn carousel__btn--prev" type="button" aria-label="Previous ad" data-carousel-prev>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3.75 9H14.25M9.75 13.5L14.25 9L9.75 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="carousel__dots" data-carousel-dots></div>
            <button class="carousel__btn carousel__btn--toggle" type="button" aria-label="Pause auto-scroll" aria-pressed="false" data-carousel-toggle>
              <svg class="icon-pause" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M6.5 4v10M11.5 4v10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <svg class="icon-play" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M6 4.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L6.9 3.7a.6.6 0 0 0-.9.5Z" fill="currentColor"/></svg>
            </button>
            <button class="carousel__btn" type="button" aria-label="Next ad" data-carousel-next>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3.75 9H14.25M9.75 13.5L14.25 9L9.75 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>
    )}

    {showPipeline && (
      <div class="pipeline">
        <div class="pipeline__text">
          <h2 class="display-m">{results.pipelineHeading}</h2>
          <p class="body-l t-muted">{results.pipelineText}</p>
        </div>
        <img class="pipeline__image" src={url(results.pipelineImage)} width="1168" height="840" alt={results.pipelineAlt} loading="lazy" />
      </div>
    )}
  </section>
)}
