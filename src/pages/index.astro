---
// The single-page site. Sections are in reading order; each lives in src/components/.
// Content lives in src/data/ (text, lists, flags). Layout and styles live in src/styles/global.css.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Problem from '../components/Problem.astro';
import Believe from '../components/Believe.astro';
import HowIWork from '../components/HowIWork.astro';
import Plans from '../components/Plans.astro';
import Results from '../components/Results.astro';
import Testimonials from '../components/Testimonials.astro';
import Event from '../components/Event.astro';
import About from '../components/About.astro';
import Fit from '../components/Fit.astro';
import Ctas from '../components/Ctas.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import logos from '../data/logos.json';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <LogoStrip title={logos.clients.title} items={logos.clients.items} ariaLabel="Companies I’ve worked with" />
    <Problem />
    <Believe />
    <HowIWork />
    <Plans />
    <Results />
    <Testimonials />
    <Event />
    <LogoStrip title={logos.tools.title} items={logos.tools.items} ariaLabel="Tools and partners I work with" reverse />
    <About />
    <Fit />
    <Ctas />
    <Faq />
  </main>
  <Footer />

  <!-- Animation and scroll libraries (loaded before our own script, which uses them) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/vanilla-tilt@1.8.1/dist/vanilla-tilt.min.js"></script>
  <script>
    import '../scripts/main.js';
  </script>
</Base>
