---
// The single-page site. The sections, their order and which are shown are listed in src/data/sections.json:
// this page renders them from that list. Each section is a component in src/components/.
// Content lives in src/data/ (text, lists, links). Layout and styles live in src/styles/global.css.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import LogosClients from '../components/LogosClients.astro';
import Problem from '../components/Problem.astro';
import Believe from '../components/Believe.astro';
import HowIWork from '../components/HowIWork.astro';
import Plans from '../components/Plans.astro';
import Results from '../components/Results.astro';
import Testimonials from '../components/Testimonials.astro';
import Event from '../components/Event.astro';
import LogosTools from '../components/LogosTools.astro';
import About from '../components/About.astro';
import Fit from '../components/Fit.astro';
import Ctas from '../components/Ctas.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { pageSections } from '../lib/sections';

// Which component draws which section key in sections.json
const components: Record<string, any> = {
  hero: Hero,
  logosClients: LogosClients,
  problem: Problem,
  believe: Believe,
  howIWork: HowIWork,
  plans: Plans,
  results: Results,
  testimonials: Testimonials,
  event: Event,
  logosTools: LogosTools,
  about: About,
  fit: Fit,
  ctas: Ctas,
  faq: Faq,
};
const visible = pageSections.filter((s) => s.show && components[s.key]);
---

<Base>
  <Nav />
  <main id="main">
    {visible.map((s) => {
      const Section = components[s.key];
      return <Section />;
    })}
  </main>
  <Footer />

  <!-- Animation and scroll libraries (loaded before our own script, which uses them) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/vanilla-tilt@1.8.1/dist/vanilla-tilt.min.js"></script>
  <script>
    import '../scripts/main.js';
  </script>
</Base>
