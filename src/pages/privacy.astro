---
// DRAFT privacy notice: plain-language template. Confirm company details, the contact address and the tools
// listed below with Thilak (and someone who handles legal) before launch.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Privacy — Headturner" noindex>
  <header class="nav is-scrolled">
    <a class="nav__logo" href="/" aria-label="Headturner home"><img src="/assets/logo-ink.svg" width="157" height="18" alt="Headturner" /></a>
    <a class="btn btn--light" href="/"><span class="back-arrow"><img src="/assets/arrow-ink.svg" width="18" height="18" alt="" /></span> Back to site</a>
  </header>

  <main class="legal">
    <header>
      <span class="pill pill--outline">PRIVACY</span>
      <h1 class="display-m">Privacy notice</h1>
      <p>Last updated: [date]. This notice explains what personal data Headturner collects through this website, why, and what you can do about it.</p>
      <p class="note">Draft for review: company details, contact address and the tools listed below still need to be confirmed.</p>
    </header>

    <section>
      <h2 class="heading-s">Who we are</h2>
      <p>Headturner is run by Thilak Sarda in Belgium. For anything privacy-related, contact [privacy email].</p>
    </section>

    <section>
      <h2 class="heading-s">What we collect and why</h2>
      <ul>
        <li><strong>Your email address</strong>, when you request the Thought Leader Ads Playbook, so we can send it to you.</li>
        <li><strong>Your name, company and contact details</strong>, when you book a call, so we can prepare for and hold that conversation.</li>
        <li><strong>Basic, anonymous usage data</strong> (such as pages visited), if analytics are enabled, to understand how the site is used.</li>
      </ul>
      <p>We don’t sell your data, and we only use it for the purposes above.</p>
    </section>

    <section>
      <h2 class="heading-s">How long we keep it</h2>
      <p>We keep your data only as long as needed for the purpose it was collected for, then delete it. You can unsubscribe from any email at any time.</p>
    </section>

    <section>
      <h2 class="heading-s">Your rights</h2>
      <p>Under the GDPR you can ask to see, correct, delete or export your data, or object to how it’s used. Email [privacy email] and we’ll respond within 30 days. You can also lodge a complaint with the Belgian Data Protection Authority.</p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .legal { width: min(720px, 100%); margin: 0 auto; padding: 160px var(--gutter) var(--section-y); display: flex; flex-direction: column; gap: 40px; }
  .legal header { display: flex; flex-direction: column; gap: 20px; }
  .legal section { display: flex; flex-direction: column; gap: 12px; }
  .legal p, .legal li { color: var(--text-muted); line-height: 1.6; }
  .legal ul { list-style: disc; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .legal a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .legal .note { padding: 16px 20px; border-radius: var(--radius-md); background: var(--coral-tint); color: var(--coral-dark); font-size: 14px; }
  .back-arrow { display: inline-flex; transform: rotate(180deg); }
</style>
